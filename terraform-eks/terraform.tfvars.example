aws_region      = "us-east-1"
environment     = "dev"
cluster_name    = "voting-app"
cluster_version = "1.35" # confirme a versão atual com `aws eks describe-cluster-versions`

vpc_cidr = "10.0.0.0/16"
azs      = ["us-east-1a", "us-east-1b", "us-east-1c"]

private_subnet_cidrs = ["10.0.0.0/19", "10.0.32.0/19", "10.0.64.0/19"]
public_subnet_cidrs  = ["10.0.96.0/20", "10.0.112.0/20", "10.0.128.0/20"]

single_nat_gateway = true

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND"
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

cluster_endpoint_public_access       = true
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"] # restrinja ao seu IP/VPN em produção

tags = {
  Project     = "voting-app"
  Environment = "dev"
  ManagedBy   = "terraform"
}
